# ==============================================================================
# LabLink Environment Configuration Template
# Copy this file to .env and adjust variables as needed for your environment.
# ==============================================================================

# Flask Session Security Key
SECRET_KEY=lablink-secure-session-key-change-in-production

# Server Host & Port
HOST=127.0.0.1
PORT=5000

# Optional Google Gemini GenAI API Key
# If left empty, LabLink operates in Local Intelligent Recommendation Mode (100% deterministic & offline)
GEMINI_API_KEY=
